# Copy this file to .env and fill in your key.
# Default provider is Groq -- free tier, no card required.
# Get a key at: https://console.groq.com/keys

LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# --- Login credentials for the app itself ---
# Set your own username/password here. These are never sent to GitHub as
# long as .env stays out of your repo (check your .gitignore).
LOGIN_USERNAME=basavaprasadkm
LOGIN_PASSWORD=Prasad@66

# --- Alternative: local Ollama (fully free, no key, NO RATE LIMITS at all) ---
# This is the permanent fix if you keep hitting 429 errors on Groq's free tier.
# 1. Install Ollama from https://ollama.com
# 2. In a terminal: ollama pull llama3.1
# 3. Uncomment these two lines and leave LLM_API_KEY blank:
# LLM_BASE_URL=http://localhost:11434/v1/chat/completions
# LLM_MODEL=llama3.1
# Since it runs on your own machine, there's no per-minute request cap --
# the only limit is how fast your CPU/GPU can generate text.
