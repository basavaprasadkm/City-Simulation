# Copy this file to .env and fill in your key.
# Default provider is Groq -- free tier, no card required.
# Get a key at: https://console.groq.com/keys

LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# --- Alternative: local Ollama (fully free, no key, no rate limits) ---
# 1. Install Ollama, then: ollama pull llama3.1
# 2. Uncomment these two lines and leave LLM_API_KEY blank:
# LLM_BASE_URL=http://localhost:11434/v1/chat/completions
# LLM_MODEL=llama3.1
